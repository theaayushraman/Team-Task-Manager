# Copy this file to .env and fill in your values

# Database — Railway PostgreSQL URL is auto-injected as DATABASE_URL
# For local dev, SQLite is used by default (no config needed)
DATABASE_URL=sqlite:///./taskmanager.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Secret — change this to a long random string in production
SECRET_KEY=change-this-to-a-long-random-secret-key

# Token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
